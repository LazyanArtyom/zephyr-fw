{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: esp32 debug no-mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "no-mcuboot",
        "--mode",
        "auto"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build: esp32 release no-mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "release",
        "--boot",
        "no-mcuboot",
        "--mode",
        "auto"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build: esp32 debug mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "mcuboot",
        "--mode",
        "auto"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build: esp32 release mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "release",
        "--boot",
        "mcuboot",
        "--mode",
        "auto"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build: esp32 debug no-mcuboot clean",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "no-mcuboot",
        "--mode",
        "clean"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "export compile_commands: esp32 debug no-mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/export_compile_commands.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "no-mcuboot"
      ],
      "dependsOn": [
        "build: esp32 debug no-mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "export compile_commands: esp32 release no-mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/export_compile_commands.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "release",
        "--boot",
        "no-mcuboot"
      ],
      "dependsOn": [
        "build: esp32 release no-mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "export compile_commands: esp32 debug mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/export_compile_commands.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "mcuboot"
      ],
      "dependsOn": [
        "build: esp32 debug mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "export compile_commands: esp32 release mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/export_compile_commands.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "release",
        "--boot",
        "mcuboot"
      ],
      "dependsOn": [
        "build: esp32 release mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "package: esp32 debug no-mcuboot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/package.sh",
      "args": [
        "--board",
        "esp32_oled",
        "--profile",
        "debug",
        "--boot",
        "no-mcuboot"
      ],
      "dependsOn": [
        "build: esp32 debug no-mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash: esp32",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flash.sh",
      "args": [
        "--port",
        "${input:esp32SerialPort}",
        "--image",
        "${workspaceFolder}/build/esp32_oled/debug/no-mcuboot/zephyr/zephyr.bin",
        "--chip",
        "esp32",
        "--offset",
        "0x1000"
      ],
      "dependsOn": [
        "build: esp32 debug no-mcuboot"
      ],
      "problemMatcher": []
    },
    {
      "label": "monitor: esp32 uart",
      "type": "shell",
      "command": "picocom",
      "args": [
        "-b",
        "115200",
        "${input:esp32SerialPort}"
      ],
      "problemMatcher": []
    },
    {
      "label": "check: format",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check_format.sh",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "check: clang-tidy",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run-clang-tidy.sh",
      "args": [
        "build/esp32_oled/debug/no-mcuboot"
      ],
      "dependsOn": [
        "build: esp32 debug no-mcuboot"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "kb: build debug no-mcuboot",
      "type": "shell",
      "dependsOn": [
        "export compile_commands: esp32 debug no-mcuboot"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "kb: build release no-mcuboot",
      "type": "shell",
      "dependsOn": [
        "export compile_commands: esp32 release no-mcuboot"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "kb: build debug mcuboot",
      "type": "shell",
      "dependsOn": [
        "export compile_commands: esp32 debug mcuboot"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "kb: build release mcuboot",
      "type": "shell",
      "dependsOn": [
        "export compile_commands: esp32 release mcuboot"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "esp32SerialPort",
      "type": "promptString",
      "description": "Host serial port, for example /dev/cu.usbserial-11120 or /dev/ttyUSB0",
      "default": "/dev/cu.usbserial-11120"
    }
  ]
}
