menu "Application"

config APP_SHELL
    bool "Enable application shell commands"
    default y
    depends on SHELL

config APP_HELLO_TOOL
    bool "Enable hello_world shell tool"
    default y

config APP_BOARD_INFO
    bool "Enable board information helpers"
    default y

config APP_HEARTBEAT_SERVICE
    bool "Enable heartbeat background service"
    default y

config APP_DISPLAY
    bool "Enable display support"
    default n
    depends on DISPLAY

endmenu
